# Required
PORTAINER_URL=https://portainer.example.com:9443

# AI provider — set ONE of the two key blocks below to enable the Assistant
# and AI triage. If both are set, AI_PROVIDER picks the active one (defaults
# to anthropic when both are present and AI_PROVIDER is unset).
# AI_PROVIDER=anthropic   # or "openai"

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-...

# --- OpenAI-compatible (OpenAI, Ollama, vLLM, OpenRouter, LM Studio, Azure, ...) ---
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Optional — HTTPS port (default 443)
PORT=443

# Optional — HTTP redirect port (default 80)
HTTP_PORT=80

# Optional — provide real TLS certs (omit to use auto-generated self-signed)
# SSL_CERT=/certs/fullchain.pem
# SSL_KEY=/certs/privkey.pem

# Optional — directory to store generated self-signed cert (default: app dir)
# SSL_CERT_DIR=/certs
